{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hm/map-marker",
  "version": "0.1.0",
  "title": "Map Marker",
  "category": "widgets",
  "icon": "location",
  "description": "A pinned location on a map, with associated content.",
  "parent": [
    "hm/map"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "id": {
      "type": "number",
      "default": 0
    },
    "lat": {
      "type": "number",
      "default": 0
    },
    "long": {
      "type": "number",
      "default": 0
    }
  },
  "example": {},
  "supports": {
    "html": false,
    "align": [
      "full"
    ]
  },
  "textdomain": "hm-map-block",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}